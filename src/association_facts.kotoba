(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count topic by-topic-count by-topic-id]))
(defn association-covered? [a :string] :bool (string=? a "boj"))
(defn entry-count [a :string] :i64 (if (association-covered? a) 2 0))
(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (= i 0) true (if (= i 1) true false)) false))
(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (if (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "boj.gyomu-hoho-sho")
        (string=? f "title") (option-some-of [:option :string] "日本銀行業務方法書 (Bank of Japan Business Operations Manual)")
        (string=? f "association") (option-some-of [:option :string] "boj")
        (string=? f "isic") (option-some-of [:option :string] "6411")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.boj.or.jp/about/boj_law/ghousyo.htm")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1998-04-01")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2026-04-01")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string]))
      (cond
        (string=? f "id") (option-some-of [:option :string] "boj.independence-transparency-overview")
        (string=? f "title") (option-some-of [:option :string] "日本銀行の「独立性」と「透明性」――新日本銀行法の概要 (Independence and Transparency -- Overview of the New Bank of Japan Law)")
        (string=? f "association") (option-some-of [:option :string] "boj")
        (string=? f "isic") (option-some-of [:option :string] "6411")
        (string=? f "country") (option-some-of [:option :string] "JPN")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.boj.or.jp/about/outline/expdokuritsu.htm")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1998-04-01")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-15")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn topic-count [a :string i :i64] :i64 (if (valid-entry? a i) 2 0))
(defn topic [a :string i :i64 ti :i64] [:option :string]
  (if (valid-entry? a i)
    (if (= ti 0) (option-some-of [:option :string] "governance")
      (if (= ti 1) (if (= i 0) (option-some-of [:option :string] "operations")
                       (option-some-of [:option :string] "transparency"))
        (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn by-topic-count [a :string t :string] :i64
  (if (association-covered? a)
    (if (string=? t "governance") 2
      (if (string=? t "operations") 1 (if (string=? t "transparency") 1 0))) 0))
(defn by-topic-id [a :string t :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (string=? t "governance")
      (if (= i 0) (entry-field a 0 "id") (if (= i 1) (entry-field a 1 "id") (option-none-of [:option :string])))
      (if (= i 0)
        (if (string=? t "operations") (entry-field a 0 "id")
          (if (string=? t "transparency") (entry-field a 1 "id") (option-none-of [:option :string])))
        (option-none-of [:option :string])))
    (option-none-of [:option :string])))
(defn main [] :i64 0)
